# ---------------------------------------------------------------- servidor --
HOST=0.0.0.0
PORT=8090
# "*" permite conectar desde cualquier maquina de la red local.
# Para restringir: CORS_ORIGINS=http://192.168.1.50:5173,http://localhost:5173
CORS_ORIGINS=*

# --------------------------------------------------------------------- LLM --
# ollama | openai_compat  (llama.cpp server, LM Studio, vLLM, ...)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
# Ventana de contexto. 16384 va comodo en 32 GB; 32768 tambien entra pero
# consume mas RAM y hace mas lento el prefill en CPU.
LLM_NUM_CTX=16384
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=600
LLM_THINKING=true

# ---------------------------------------------------- proveedores de nube --
# Opcional: la clave tambien se puede escribir desde la pestana Modelo de la
# UI. Si se define aqui, la UI puede dejar su campo vacio y no hace falta
# guardar el secreto en el navegador.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------ agente --
AGENT_MAX_ITERATIONS=12
AGENT_HISTORY_MAX_MESSAGES=60
AGENT_SYSTEM_PROMPT=

# ----------------------------------------------------------------- MLflow ---
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Experimento por defecto. Desde la UI se puede elegir otro (o escribir uno
# nuevo, que se crea al vuelo) y queda guardado en cada sesion.
MLFLOW_EXPERIMENT=agente-pruebas-mcp
MLFLOW_FAIL_SOFT=true
# Cuanto esperar a MLflow antes de rendirse (segundos) y cuantos reintentos.
# Con los valores por defecto de MLflow (7 reintentos con backoff) una caida
# del servidor deja colgada la UI un par de minutos.
MLFLOW_HTTP_TIMEOUT=10
MLFLOW_HTTP_RETRIES=2
